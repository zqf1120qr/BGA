/* ==============================================================
   🌟 BGA 智能工业质检工作站 - 现代 Slate/Zinc 工业旗舰设计规范
   ============================================================== */

QMainWindow, QDialog {
    background-color: #0b0f19;
    color: #f1f5f9;
}

QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    color: #f1f5f9;
    outline: none;
}

/* 全局工具提示气泡 (QToolTip) - 清晰深色微卡片 + 亮青蓝描边 */
QToolTip {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #38bdf8;
    border-radius: 4px;
    padding: 6px 10px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 500;
}

/* 标题栏与工具栏 */
QToolBar {
    background-color: #111726;
    border-bottom: 1px solid #1e293b;
    padding: 3px 8px;
    spacing: 10px;
}

QToolBar QLabel {
    color: #94a3b8;
    font-size: 11px;
}

/* 分割器 Splitter */
QSplitter::handle {
    background-color: #1e293b;
}
QSplitter::handle:hover {
    background-color: #3b82f6;
}

/* Tab 分页控件美化 */
QTabWidget::pane {
    border: 1px solid #1e293b;
    border-radius: 8px;
    background-color: #111726;
    top: -1px;
}

QTabBar::tab {
    background-color: #0b0f19;
    color: #94a3b8;
    border: 1px solid #1e293b;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 16px;
    font-weight: 500;
    font-size: 12px;
    margin-right: 4px;
}

QTabBar::tab:hover {
    background-color: #161e31;
    color: #f8fafc;
}

QTabBar::tab:selected {
    background-color: #111726;
    color: #38bdf8;
    font-weight: bold;
    border-top: 2px solid #3b82f6;
}

/* 卡片容器 Frame 通用 (左右侧所有区域完全采用一致的圆角矩形背景) */
QFrame#ControlActionPanel, QFrame#ParamPanel {
    background-color: transparent;
    border: none;
}

QFrame#ImageCard, QFrame#EngineCard, QFrame#ThreshCard, QFrame#ActionCard, 
QFrame#ResultSummaryPanel, QFrame#DefectTablePanel {
    background-color: #111726;
    border: 1px solid #1e293b;
    border-radius: 8px;
}

/* 内部深色数据区块 (FileInfoFrame、ResultGridFrame 保持 100% 相同视觉质感) */
QFrame#FileInfoFrame, QFrame#ResultGridFrame {
    background-color: #0b0f19;
    border: 1px solid #1e293b;
    border-radius: 6px;
}

/* 滚动区域与背景容器 (杜绝白色漏光) */
QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background-color: #0b0f19;
    border: none;
}

/* 按钮通用规范 (简约大方低调描边 + 悬停亮青蓝高光，字体完全一致杜绝抖动) */
QPushButton {
    background-color: #141d2d;
    color: #cbd5e1;
    border: 1px solid #243044;
    border-radius: 6px;
    padding: 6px 10px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #1e293b;
    border: 1px solid #38bdf8;
    color: #ffffff;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}

QPushButton:pressed {
    background-color: #0f172a;
    border: 1px solid #2563eb;
    color: #ffffff;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}

QPushButton:checked {
    background-color: #1e293b;
    border: 1px solid #38bdf8;
    color: #38bdf8;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}

QPushButton:disabled {
    background-color: #0f1420;
    color: #475569;
    border: 1px solid #1e293b;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}

/* 核心行动大按钮 (Primary) */
QPushButton#BtnPrimary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1d4ed8, stop:1 #2563eb);
    border: 1px solid #3b82f6;
    color: #ffffff;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 9px;
    border-radius: 6px;
    letter-spacing: 0.5px;
}

QPushButton#BtnPrimary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #3b82f6);
    border: 1px solid #60a5fa;
    color: #ffffff;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 9px;
    border-radius: 6px;
    letter-spacing: 0.5px;
}

QPushButton#BtnPrimary:pressed {
    background-color: #1e40af;
    border: 1px solid #1d4ed8;
    color: #ffffff;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 9px;
    border-radius: 6px;
    letter-spacing: 0.5px;
}

/* 成功与危险操作按钮 */
QPushButton#BtnConfirm {
    background-color: #064e3b;
    border: 1px solid #059669;
    color: #ffffff;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#BtnConfirm:hover {
    background-color: #047857;
    border: 1px solid #10b981;
    color: #ffffff;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#BtnCancel {
    background-color: #4c0519;
    border: 1px solid #be123c;
    color: #ffffff;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#BtnCancel:hover {
    background-color: #881337;
    border: 1px solid #f43f5e;
    color: #ffffff;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}

/* 下拉菜单 ComboBox (简约质感描边 + 悬浮亮青蓝发光) */
QComboBox {
    background-color: #141d2d;
    color: #cbd5e1;
    border: 1px solid #243044;
    border-radius: 6px;
    padding: 6px 24px 6px 8px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 500;
}

QComboBox:hover {
    background-color: #1e293b;
    border: 1px solid #38bdf8;
    color: #ffffff;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 500;
}

QComboBox:focus {
    border: 1px solid #38bdf8;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 500;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #243044;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #141d2d;
}

QComboBox::drop-down:hover {
    border-left: 1px solid #38bdf8;
    background-color: #1e293b;
}

QComboBox::down-arrow {
    image: url(arrow_down.png);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #0f172a;
    border: 1px solid #334155;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    color: #e2e8f0;
    padding: 4px;
}

/* 滑块 Slider */
QSlider::groove:horizontal {
    height: 4px;
    background: #1e293b;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #3b82f6;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #60a5fa;
    border: 2px solid #ffffff;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #93c5fd;
    border-color: #ffffff;
}

/* 单选框与复选框 (分段胶囊效果) */
QRadioButton {
    spacing: 6px;
    font-size: 11px;
    color: #94a3b8;
}

QRadioButton:checked {
    color: #38bdf8;
    font-weight: bold;
}

QRadioButton::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid #475569;
    border-radius: 6px;
    background-color: #0b0f19;
}

QRadioButton::indicator:checked {
    background-color: #3b82f6;
    border: 2px solid #ffffff;
}

/* 表格组件 */
QTableWidget {
    background-color: #0b0f19;
    color: #f1f5f9;
    gridline-color: #1e293b;
    border: 1px solid #1e293b;
    border-radius: 6px;
    font-size: 11px;
    selection-background-color: #1e3a8a;
    selection-color: #ffffff;
}

QTableWidget::item:hover {
    background-color: #1a2538;
}

QHeaderView::section {
    background-color: #161e31;
    color: #94a3b8;
    padding: 5px 2px;
    border: 1px solid #1e293b;
    font-weight: bold;
    font-size: 11px;
}

/* 滚动条 */
QScrollBar:vertical {
    border: none;
    background: #0b0f19;
    width: 8px;
}
QScrollBar::handle:vertical {
    background: #273449;
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #38bdf8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background: #0b0f19;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #273449;
    min-width: 24px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #38bdf8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* 状态栏 */
QStatusBar {
    background-color: #0b0f19;
    color: #64748b;
    border-top: 1px solid #1e293b;
    font-size: 11px;
    padding: 2px 6px;
}

QProgressBar {
    border: 1px solid #273449;
    border-radius: 4px;
    text-align: center;
    background-color: #0b0f19;
    color: #ffffff;
    font-size: 10px;
    height: 12px;
}
QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 3px;
}

/* 批量图像胶卷栏与导航控件 */
QFrame#BatchThumbnailBar {
    background-color: #111726;
    border-top: 1px solid #1e293b;
}

QPushButton#BtnNav {
    background-color: #141d2d;
    border: 1px solid #243044;
    border-radius: 5px;
    padding: 3px 10px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 600;
    color: #cbd5e1;
}

QPushButton#BtnNav:hover {
    background-color: #1e293b;
    border: 1px solid #38bdf8;
    color: #ffffff;
}

QPushButton#BtnNav:pressed {
    background-color: #0f172a;
    border: 1px solid #0284c7;
    color: #ffffff;
}

QPushButton#BtnNav:disabled {
    background-color: #0b0f19;
    border: 1px solid #1e293b;
    color: #475569;
}

